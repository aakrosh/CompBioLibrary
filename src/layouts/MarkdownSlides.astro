---
interface Props {
  title: string;
  description?: string;
  author?: string;
  affiliation?: string;
  date?: string;
  course?: string;
  googleFont?: string;
  body: string;
}

const { title, description, author, affiliation, date, course, googleFont, body } = Astro.props;

const showTitleSlide = !!(title && (author || date || course || description));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.2.1/dist/reveal.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.2.1/dist/theme/black.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@5.2.1/plugin/highlight/monokai.css" />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}theme.css`} />
    {googleFont && (
      <>
        <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=${googleFont}&display=swap`} />
        <style set:html={`.reveal, .reveal h1, .reveal h2, .reveal h3, .reveal h4, .reveal p, .reveal li, .reveal td, .reveal th, .reveal blockquote { font-family: '${googleFont.split(':')[0].replace(/\+/g, ' ')}', sans-serif !important; }`} />
      </>
    )}
  </head>
  <body>
    <div class="reveal">
      <div class="slides">
        {showTitleSlide && (
          <section>
              <h1>{title}</h1>
              {description && <p><em>{description}</em></p>}
              {author && <p>{author}</p>}
              {affiliation && <p>{affiliation}</p>}
              {course && <p>{course}</p>}
              {date && <p>{date}</p>}
          </section>
        )}
        <section data-markdown data-separator="^---$" data-separator-vertical="^--$" data-separator-notes="^Note:">
          <textarea data-template set:text={body}></textarea>
        </section>
      </div>
    </div>

    <script is:inline src="/socket.io/socket.io.js"></script>
    <script is:inline src="/reveal-notes-server/client.js"></script>

    <script>
      import Reveal from 'reveal.js';
      import Markdown from 'reveal.js/plugin/markdown/markdown.esm.js';
      import Highlight from 'reveal.js/plugin/highlight/highlight.esm.js';
      import Notes from 'reveal.js/plugin/notes/notes.esm.js';
      import Math from 'reveal.js/plugin/math/math.esm.js';

      window.Reveal = Reveal;
      Reveal.initialize({
        hash: true,
        slideNumber: true,
        transition: 'none',
        plugins: [Markdown, Highlight, Notes, Math.KaTeX],
      });
    </script>
  </body>
</html>
